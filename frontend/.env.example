# Backend API URL (only needed for local development)
# In production, Netlify proxy handles routing automatically
# Local development: http://localhost:8001
# Production: Leave empty or don't set (proxy handles it via netlify.toml)
REACT_APP_BACKEND_URL=http://localhost:8001

# Stripe configuration removed

# Paddle Configuration (optional)
# Set these after running setup-paddle.js or from your Paddle dashboard
# Example IDs look like pri_01kd8x6ptq7hbcn8bp5xyz
REACT_APP_PADDLE_PRICE_CODE_14D=pri_...
REACT_APP_PADDLE_PRICE_CODE_30D=pri_...
REACT_APP_PADDLE_PRICE_VIDEO_1M=pri_...
REACT_APP_PADDLE_PRICE_VIDEO_2M=pri_...
REACT_APP_PADDLE_PRICE_VIDEO_3M=pri_...
