# Database
# Local development: SQLite
DATABASE_URL=sqlite:///./flash_neiga.db
# Production: PostgreSQL (auto-configured by Render)
# DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret Key (IMPORTANT: Change in production!)
SECRET_KEY=votre-secret-key-random-changez-moi-en-production

# Paddle Configuration
# Obtenir depuis: Paddle Dashboard → Developer Tools → Authentication → API Keys
PADDLE_API_KEY=
# Obtenir depuis: Paddle Dashboard → Developer Tools → Notifications → Webhook URLs
PADDLE_WEBHOOK_SECRET=

# CORS - Domaines autorisés (séparés par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional: Admin token for admin endpoints
# ADMIN_TOKEN=
