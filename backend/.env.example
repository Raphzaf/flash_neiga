# Backend environment variables (example)
# Copy to backend/.env and fill values; do NOT commit secrets

# Paddle Billing
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=production
PADDLE_WEBHOOK_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== Coach IA — Google AI / Gemini =====
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Clé Google AI Studio (https://aistudio.google.com/apikey) :
GEMINI_API_KEY=
# --- OU Vertex AI (Google Cloud) au lieu de la clé AI Studio ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=239164849877
# GOOGLE_CLOUD_LOCATION=europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/service-account.json
#
# --- Alternative : fournisseur Claude (AI_PROVIDER=claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
#
# ===== Alternative : Kimi / Moonshot AI (AI_PROVIDER=moonshot) =====
# API compatible OpenAI. La clé doit être créditée (1 $ min) sur platform.moonshot.ai.
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Modèles : kimi-k3 (1M ctx) | kimi-k2.7-code (262k) | kimi-k2.6 (262k) | kimi-k2.5 (262k)
# MOONSHOT_MODEL=kimi-k3

# ===== Administration / CRM =====
# Emails autorisés à accéder au CMS et au CRM (séparés par des virgules)
ADMIN_EMAILS=admin@gmail.com
 
 # Database
 # Local development: SQLite
 DATABASE_URL=sqlite:///./flash_neiga.db
 # Production: PostgreSQL (auto-configured by Render)
 # DATABASE_URL=postgresql://user:password@host:5432/database
 
 # JWT Secret Key (IMPORTANT: Change in production!)
 SECRET_KEY=votre-secret-key-random-changez-moi-en-production
 
 # Optional: Admin token for admin endpoints
 # ADMIN_TOKEN=

# ===== Payment Integration (HYP / Yaad Sarig) =====
HYP_TERMINAL_ID=4502176330
HYP_USER_ID=pveda
# KEY used to sign APISign requests (do NOT commit the real value)
HYP_API_KEY=
# Terminal API password (PassP); leave empty if the terminal signs with KEY only
HYP_PASSP=
HYP_API_URL=https://icom.yaad.net/p/
# Hosted payment page language: HEB or ENG
HYP_PAGE_LANG=ENG
# Rejette les notifications de paiement non signées. Laisser à true en production :
# sans cette vérification, une fausse notification ouvrirait un abonnement sans paiement.
# À passer à false uniquement en développement local, où aucune signature n'est disponible.
HYP_REQUIRE_SIGNATURE=true
# Redirect URLs
HYP_SUCCESS_URL=http://localhost:3000/payment/success
HYP_ERROR_URL=http://localhost:3000/payment/failure
HYP_CALLBACK_URL=http://localhost:8000/api/payments/hyp/callback
