# Production Environment Variables Template
# Copy this file when deploying to production and fill in the actual values
# DO NOT commit the actual .env file with real credentials to version control

# ===== Database Configuration =====
# Production PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# 
# For Render.com (Internal URL - use within Render services):
# DATABASE_URL=postgresql://flash_neiga_user:XbM2WHVQLhAShKB8axTj2DPkbquOxDX6@dpg-d4v0ld6uk2gs7394fbm0-a/flash_neiga
#
# For Render.com (External URL - use for local connection to production):
# DATABASE_URL=postgresql://flash_neiga_user:XbM2WHVQLhAShKB8axTj2DPkbquOxDX6@dpg-d4v0ld6uk2gs7394fbm0-a.oregon-postgres.render.com/flash_neiga
DATABASE_URL=postgresql://username:password@host:5432/database

# ===== Security =====
# JWT Secret Key - MUST be a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Optional: Admin API token for protected admin endpoints
# ADMIN_TOKEN=your-admin-token-here

# ===== Frontend Configuration =====
# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-domain.netlify.app

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://your-frontend-domain.netlify.app,https://www.your-domain.com

# ===== Payment Integration (HYP) =====
# HYP Payment Platform API Credentials
HYP_TERMINAL_ID=4502176330
HYP_USER_ID=pveda
HYP_API_KEY=your-hyp-api-key-here
HYP_API_URL=https://icom.yaad.net/p/

# HYP Callback URLs (configure according to your domain)
HYP_SUCCESS_URL=https://your-frontend-domain.netlify.app/payment/success
HYP_ERROR_URL=https://your-frontend-domain.netlify.app/payment/failure
HYP_CALLBACK_URL=https://your-backend-domain.onrender.com/api/payments/hyp/callback

# ===== Application Settings =====
# Python version (for Render)
PYTHON_VERSION=3.11

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===== Optional: External Services =====
# If you integrate with other services, add their configuration here
# SENTRY_DSN=your-sentry-dsn
# REDIS_URL=redis://your-redis-host:6379
